<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="VatA" value="0.175" />
    <add key="VatE" value="0.00" />
    <add key="MRABaseUrl" value="http://localhost:5236" />
    <add key="MRAServerUrl" value="https://dev-eis-api.mra.mw" />
    <add key="GetConfigProductCode" value="true" />
    <add key="ProductMatchThreshold" value="0.50" />
    <add key="CompanyName" value="Mitch Pharmacy" />
    <add key="CompanyTIN" value="" />
    <add key="CompanyVAT" value="" />
    <add key="CompanyRegNum" value="" />
    <add key="DeviceSerial" value="" />
    <add key="DeviceId" value="" />
    <add key="setPrinter" value="false" />
    <add key="PrinterName" value="Microsoft Print To Pdf" />
    <add key="NumberOfCopies" value="1" />
    <add key="LastZReportDate" value="" />
    <add key="AutomateZReport" value="false" />
    <add key="targetDir2" value="C:\Backup" />
    <add key="Message" value="" />
    <add key="AutoZReport" value="false" />
    <add key="ReadSpecificFilename" value="true" />
    <add key="SpecificFilename" value="Receipt.txt" />
    <add key="PageSize" value="Till Slips" />
    <add key="PhoneNumber" value="Cell:0731786400" />
    <add key="Email" value="Email:marketing@email.co.zw" />
    <add key="BasePath" value="C:\FISCALIZATION" />
    <add key="ReceiptFolder" value="C:\RxWin\Pos\Receipts" />
    <add key="UseCustomReceiptFolder" value="true" />
    <add key="UseReceiptFilenameForBackup" value="false" />
    <add key="BackupFilenameKey" value="" />
    <add key="CurrentInvoiceNumber" value="Inv001" />
    <add key="CreditDebitReason" value="goods returned" />
    <add key="InvoiceFlag" value="01" />
    <add key="CreditNoteReason" value="goods returned" />
    <add key="LogoFile" value="logo.jpg" />
    <add key="VatFlag" value="1" />
    <add key="Trained" value="1" />
    <add key="CreditNoteRef" value="REFERENCE NO:" />
    <add key="CustomerName" value="Account No:" />
    <add key="CustomerTIN" value="TIN NO:" />
    <add key="CustomerVAT" value="VAT NO:" />
    <add key="CustomerTEL" value="PHONE NO:" />
    <add key="CustomerAdd" value="ADDRESS:" />
    <add key="CustomerEmail" value="CustomerEmail:" />
    <add key="CompanyAddress" value="Shop No 13 &amp; 14&#xA;Kensington &#xA;Harare&#xA;Zimbabwe &#xA;Tel: 0424-700475-7, 700810" />
    <add key="MultiLineProduct" value="1" />
    <add key="InvoiceNumber" value="Trans No:" />
    <add key="Cashier" value="Cashier" />
    <add key="ProductStartLine" value="QTY" />
    <add key="ProductEndLine" value="Sub Total" />
    <add key="DefaultCurrency" value="MWK" />
    <add key="ItemDotCounter" value="1" />
    <add key="InvoiceIdentifierText" value="QTY" />
    <add key="RandomNumber" value="987654321" />
    <add key="Prefix" value="" />
    <!--For small receipts-->
    <add key="ProductStartLine2" value="Invoice:" />
    <add key="ProductEndLine2" value="TAX $" />
    <add key="VatFlag2" value="1" />
    <add key="ItemDotCounter2" value="2" />
    <add key="InvoiceIdentifierText2" value="Qtyg" />
    <add key="InvoiceNumber2" value="Invoice:" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Data.SQLite" publicKeyToken="db937bc2d44ff139" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.4.0" newVersion="2.0.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
      <provider invariantName="System.Data.SQLite.EF6" type="System.Data.SQLite.EF6.SQLiteProviderServices, System.Data.SQLite.EF6" />
    </providers>
  </entityFramework>
  <system.data>
    <DbProviderFactories>
      <remove invariant="System.Data.SQLite.EF6" />
      <add name="SQLite Data Provider (Entity Framework 6)" invariant="System.Data.SQLite.EF6" description=".NET Framework Data Provider for SQLite (Entity Framework 6)" type="System.Data.SQLite.EF6.SQLiteProviderFactory, System.Data.SQLite.EF6" />
    <remove invariant="System.Data.SQLite" /><add name="SQLite Data Provider" invariant="System.Data.SQLite" description=".NET Framework Data Provider for SQLite" type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" /></DbProviderFactories>
  </system.data>
</configuration>